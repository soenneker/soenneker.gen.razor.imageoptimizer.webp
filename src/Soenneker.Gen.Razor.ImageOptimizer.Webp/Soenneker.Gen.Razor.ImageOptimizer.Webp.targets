<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <!-- Select the SDK host rather than the application's RuntimeIdentifier (for example browser-wasm). -->
        <ImageOptimizerWebpToolRuntimeIdentifier Condition="'$(ImageOptimizerWebpToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ImageOptimizerWebpToolRuntimeIdentifier>
        <_ImageOptimizerWebpExecutableName>Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks</_ImageOptimizerWebpExecutableName>
        <_ImageOptimizerWebpExecutableName Condition="$([System.String]::Copy('$(ImageOptimizerWebpToolRuntimeIdentifier)').StartsWith('win-'))">$(_ImageOptimizerWebpExecutableName).exe</_ImageOptimizerWebpExecutableName>
        <_ImageOptimizerWebpNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(ImageOptimizerWebpToolRuntimeIdentifier)/$(_ImageOptimizerWebpExecutableName)'))</_ImageOptimizerWebpNativePackagePath>
        <_ImageOptimizerWebpNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(ImageOptimizerWebpToolRuntimeIdentifier)/$(_ImageOptimizerWebpExecutableName)'))</_ImageOptimizerWebpNativeProjectPath>
        <ImageOptimizerWebpBuildTasksExecutablePath Condition="'$(ImageOptimizerWebpBuildTasksExecutablePath)' == '' and Exists('$(_ImageOptimizerWebpNativePackagePath)')">$(_ImageOptimizerWebpNativePackagePath)</ImageOptimizerWebpBuildTasksExecutablePath>
        <ImageOptimizerWebpBuildTasksExecutablePath Condition="'$(ImageOptimizerWebpBuildTasksExecutablePath)' == ''">$(_ImageOptimizerWebpNativeProjectPath)</ImageOptimizerWebpBuildTasksExecutablePath>

        <_ImageOptimizerWebpTargetsPath>$(MSBuildThisFileFullPath)</_ImageOptimizerWebpTargetsPath>

        <ImageOptimizerWebpEnabled Condition="'$(ImageOptimizerWebpEnabled)'==''">true</ImageOptimizerWebpEnabled>
        <ImageOptimizerWebpWwwRootPath Condition="'$(ImageOptimizerWebpWwwRootPath)'==''">$(ProjectDir)wwwroot</ImageOptimizerWebpWwwRootPath>
        <ImageOptimizerWebpSourceExtensions Condition="'$(ImageOptimizerWebpSourceExtensions)'==''">png;jpg;jpeg</ImageOptimizerWebpSourceExtensions>
        <ImageOptimizerWebpQuality Condition="'$(ImageOptimizerWebpQuality)'==''">80</ImageOptimizerWebpQuality>
        <ImageOptimizerWebpEffort Condition="'$(ImageOptimizerWebpEffort)'==''">4</ImageOptimizerWebpEffort>
        <ImageOptimizerWebpLossless Condition="'$(ImageOptimizerWebpLossless)'==''">false</ImageOptimizerWebpLossless>
        <ImageOptimizerWebpStripMetadata Condition="'$(ImageOptimizerWebpStripMetadata)'==''">true</ImageOptimizerWebpStripMetadata>
        <ImageOptimizerWebpCachePath Condition="'$(ImageOptimizerWebpCachePath)'==''">$(BaseIntermediateOutputPath)imageoptimizer-webp/settings.txt</ImageOptimizerWebpCachePath>
        <ImageOptimizerWebpForce Condition="'$(ImageOptimizerWebpForce)'==''">false</ImageOptimizerWebpForce>
        <ImageOptimizerWebpFailOnError Condition="'$(ImageOptimizerWebpFailOnError)'==''">true</ImageOptimizerWebpFailOnError>

        <_ImageOptimizerWebpProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_ImageOptimizerWebpProjectDir>
        <_ImageOptimizerWebpProjectDir Condition="'$(_ImageOptimizerWebpProjectDir)'==''">$(MSBuildProjectDirectory)</_ImageOptimizerWebpProjectDir>
        <_ImageOptimizerWebpOutputPathArg Condition="'$(ImageOptimizerWebpOutputPath)'!=''"> --outputPath &quot;$(ImageOptimizerWebpOutputPath)&quot;</_ImageOptimizerWebpOutputPathArg>
    </PropertyGroup>


    <!-- Keep the inventory outside the generated asset directories. Recording file names
         and timestamps catches additions, removals, missing outputs, and option changes. -->
    <Target Name="PrepareImageOptimizerWebpInputs"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(ImageOptimizerWebpEnabled)'=='true'">
        <PropertyGroup>
            <_ImageOptimizerWebpInputManifest>$(IntermediateOutputPath)imageoptimizer-webp.inputs</_ImageOptimizerWebpInputManifest>
            <_ImageOptimizerWebpSuccessStamp>$(IntermediateOutputPath)imageoptimizer-webp.stamp</_ImageOptimizerWebpSuccessStamp>
        </PropertyGroup>
        <MakeDir Directories="$(IntermediateOutputPath)" />
        <ItemGroup>
            <_ImageOptimizerWebpTrackedFiles Remove="@(_ImageOptimizerWebpTrackedFiles)" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpWwwRootPath)/**/*" Exclude="$(_ImageOptimizerWebpInputManifest);$(_ImageOptimizerWebpSuccessStamp)" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpOutputPath)/**/*" Exclude="$(_ImageOptimizerWebpInputManifest);$(_ImageOptimizerWebpSuccessStamp)" Condition="'$(ImageOptimizerWebpOutputPath)'!=''" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpManifestPath)" Condition="'$(ImageOptimizerWebpManifestPath)'!='' and Exists('$(ImageOptimizerWebpManifestPath)')" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpCachePath)" Condition="'$(ImageOptimizerWebpCachePath)'!='' and Exists('$(ImageOptimizerWebpCachePath)')" />
            <_ImageOptimizerWebpTrackedFiles Include="$(_ImageOptimizerWebpTargetsPath);$(MSBuildProjectFullPath);$(MSBuildAllProjects);$(ProjectAssetsFile);$(ImageOptimizerWebpBuildTasksExecutablePath)" />
        </ItemGroup>
        <WriteLinesToFile File="$(_ImageOptimizerWebpInputManifest)"
                          Lines="@(_ImageOptimizerWebpTrackedFiles->'%(FullPath)|%(ModifiedTime)');ImageOptimizerWebpCachePath=$(ImageOptimizerWebpCachePath);ImageOptimizerWebpOutputPath=$(ImageOptimizerWebpOutputPath);ImageOptimizerWebpBuildTasksExecutablePath=$(ImageOptimizerWebpBuildTasksExecutablePath);ImageOptimizerWebpEffort=$(ImageOptimizerWebpEffort);ImageOptimizerWebpEnabled=$(ImageOptimizerWebpEnabled);ImageOptimizerWebpFailOnError=$(ImageOptimizerWebpFailOnError);ImageOptimizerWebpForce=$(ImageOptimizerWebpForce);ImageOptimizerWebpLossless=$(ImageOptimizerWebpLossless);ImageOptimizerWebpQuality=$(ImageOptimizerWebpQuality);ImageOptimizerWebpSourceExtensions=$(ImageOptimizerWebpSourceExtensions);ImageOptimizerWebpStripMetadata=$(ImageOptimizerWebpStripMetadata);ImageOptimizerWebpWwwRootPath=$(ImageOptimizerWebpWwwRootPath)"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Delete Files="$(_ImageOptimizerWebpSuccessStamp)" Condition="'$(ImageOptimizerWebpForce)'=='true' or '$(ImageOptimizerWebpFailOnError)'!='true'" />
    </Target>

    <Target Name="RunRazorImageOptimizerWebpBuildTasks"
            DependsOnTargets="PrepareImageOptimizerWebpInputs"
            Inputs="$(_ImageOptimizerWebpInputManifest)"
            Outputs="$(_ImageOptimizerWebpSuccessStamp)"
            BeforeTargets="BeforeBuild"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(ImageOptimizerWebpEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Gen.Razor.ImageOptimizer.Webp: wwwroot=$(ImageOptimizerWebpWwwRootPath) quality=$(ImageOptimizerWebpQuality)" />
        <Error Condition="'$(ImageOptimizerWebpBuildTasksExecutablePath)'==''" Text="ImageOptimizerWebpBuildTasksExecutablePath was not resolved." />
        <Error Condition="!Exists('$(ImageOptimizerWebpBuildTasksExecutablePath)')" Text="WebP image optimizer native BuildTasks executable not found at '$(ImageOptimizerWebpBuildTasksExecutablePath)'." />

        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(ImageOptimizerWebpBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_ImageOptimizerWebpProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(ImageOptimizerWebpBuildTasksExecutablePath)&quot; --projectDir &quot;$(_ImageOptimizerWebpProjectDir)&quot; --wwwRoot &quot;$(ImageOptimizerWebpWwwRootPath)&quot; --sourceExtensions &quot;$(ImageOptimizerWebpSourceExtensions)&quot; --quality &quot;$(ImageOptimizerWebpQuality)&quot; --effort &quot;$(ImageOptimizerWebpEffort)&quot; --lossless &quot;$(ImageOptimizerWebpLossless)&quot; --stripMetadata &quot;$(ImageOptimizerWebpStripMetadata)&quot; --cachePath &quot;$(ImageOptimizerWebpCachePath)&quot; --force &quot;$(ImageOptimizerWebpForce)&quot; --failOnError &quot;$(ImageOptimizerWebpFailOnError)&quot;$(_ImageOptimizerWebpOutputPathArg)' />
        <ItemGroup>
            <_ImageOptimizerWebpTrackedFiles Remove="@(_ImageOptimizerWebpTrackedFiles)" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpWwwRootPath)/**/*" Exclude="$(_ImageOptimizerWebpInputManifest);$(_ImageOptimizerWebpSuccessStamp)" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpOutputPath)/**/*" Exclude="$(_ImageOptimizerWebpInputManifest);$(_ImageOptimizerWebpSuccessStamp)" Condition="'$(ImageOptimizerWebpOutputPath)'!=''" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpManifestPath)" Condition="'$(ImageOptimizerWebpManifestPath)'!='' and Exists('$(ImageOptimizerWebpManifestPath)')" />
            <_ImageOptimizerWebpTrackedFiles Include="$(ImageOptimizerWebpCachePath)" Condition="'$(ImageOptimizerWebpCachePath)'!='' and Exists('$(ImageOptimizerWebpCachePath)')" />
            <_ImageOptimizerWebpTrackedFiles Include="$(_ImageOptimizerWebpTargetsPath);$(MSBuildProjectFullPath);$(MSBuildAllProjects);$(ProjectAssetsFile);$(ImageOptimizerWebpBuildTasksExecutablePath)" />
        </ItemGroup>
        <WriteLinesToFile File="$(_ImageOptimizerWebpInputManifest)"
                          Lines="@(_ImageOptimizerWebpTrackedFiles->'%(FullPath)|%(ModifiedTime)');ImageOptimizerWebpCachePath=$(ImageOptimizerWebpCachePath);ImageOptimizerWebpOutputPath=$(ImageOptimizerWebpOutputPath);ImageOptimizerWebpBuildTasksExecutablePath=$(ImageOptimizerWebpBuildTasksExecutablePath);ImageOptimizerWebpEffort=$(ImageOptimizerWebpEffort);ImageOptimizerWebpEnabled=$(ImageOptimizerWebpEnabled);ImageOptimizerWebpFailOnError=$(ImageOptimizerWebpFailOnError);ImageOptimizerWebpForce=$(ImageOptimizerWebpForce);ImageOptimizerWebpLossless=$(ImageOptimizerWebpLossless);ImageOptimizerWebpQuality=$(ImageOptimizerWebpQuality);ImageOptimizerWebpSourceExtensions=$(ImageOptimizerWebpSourceExtensions);ImageOptimizerWebpStripMetadata=$(ImageOptimizerWebpStripMetadata);ImageOptimizerWebpWwwRootPath=$(ImageOptimizerWebpWwwRootPath)"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <Touch Files="$(_ImageOptimizerWebpSuccessStamp)" AlwaysCreate="true" />
    </Target>
</Project>
