<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Build-time WebP image optimization for Razor applications using bundled libvips command-line distributions.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Gen.Razor.ImageOptimizer.Webp</AssemblyName>
        <PackageId>Soenneker.Gen.Razor.ImageOptimizer.Webp</PackageId>
        <PackageTags>gen razor imageoptimizer webp generator image optimizer libvips externalgenerator imageoptimizerwebp image-optimizer dotnet</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.gen.razor.imageoptimizer.webp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.gen.razor.imageoptimizer.webp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Gen.Razor.ImageOptimizer.Webp.targets" Pack="true" PackagePath="build/" />
        <None Include="Soenneker.Gen.Razor.ImageOptimizer.Webp.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <ImageOptimizerWebpNativeRuntimeIdentifier Condition="'$(ImageOptimizerWebpNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ImageOptimizerWebpNativeRuntimeIdentifier>
        <ImageOptimizerWebpNativeArtifactsDir Condition="'$(ImageOptimizerWebpNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</ImageOptimizerWebpNativeArtifactsDir>
        <_ImageOptimizerWebpNativeExecutable>Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks</_ImageOptimizerWebpNativeExecutable>
        <_ImageOptimizerWebpNativeExecutable Condition="$([System.String]::Copy('$(ImageOptimizerWebpNativeRuntimeIdentifier)').StartsWith('win-'))">$(_ImageOptimizerWebpNativeExecutable).exe</_ImageOptimizerWebpNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(ImageOptimizerWebpUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(ImageOptimizerWebpNativeSource);../Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks/obj/project.assets.json"
            Outputs="$(ImageOptimizerWebpNativeArtifactsDir)/$(ImageOptimizerWebpNativeRuntimeIdentifier)/$(_ImageOptimizerWebpNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks/Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks.csproj&quot; --configuration Release --runtime $(ImageOptimizerWebpNativeRuntimeIdentifier) --output &quot;$(ImageOptimizerWebpNativeArtifactsDir)/$(ImageOptimizerWebpNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <ImageOptimizerWebpNativeSource Include="../Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks/**/*.cs;../Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks/bin/**;../Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_ImageOptimizerWebpRequiredRuntime Include="win-x64;linux-x64" Condition="'$(ImageOptimizerWebpUsePrebuiltNativeTools)' == 'true'" />
            <_ImageOptimizerWebpNativeFile Include="$(ImageOptimizerWebpNativeArtifactsDir)/**/*"
                                Exclude="$(ImageOptimizerWebpNativeArtifactsDir)/win-x64/Resources/linux-x64/**;$(ImageOptimizerWebpNativeArtifactsDir)/linux-x64/Resources/win-x64/**;$(ImageOptimizerWebpNativeArtifactsDir)/**/*.pdb;$(ImageOptimizerWebpNativeArtifactsDir)/**/*.dbg;$(ImageOptimizerWebpNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_ImageOptimizerWebpNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_ImageOptimizerWebpRequiredRuntime)' != '' and !Exists('$(ImageOptimizerWebpNativeArtifactsDir)/%(_ImageOptimizerWebpRequiredRuntime.Identity)/Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks') and !Exists('$(ImageOptimizerWebpNativeArtifactsDir)/%(_ImageOptimizerWebpRequiredRuntime.Identity)/Soenneker.Gen.Razor.ImageOptimizer.Webp.BuildTasks.exe')"
               Text="Missing native imageoptimizer.webp tool for %(_ImageOptimizerWebpRequiredRuntime.Identity)." />
        <Error Condition="'@(_ImageOptimizerWebpNativeFile)' == ''" Text="Native imageoptimizer.webp tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
